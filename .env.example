# Copie este arquivo para ".env" e preencha com os dados do servidor PostgreSQL
# da rede local. Nunca versione o arquivo ".env" real (dados sensíveis).

DB_HOST=192.168.0.10
DB_PORT=5432
DB_NAME=fiado_db
DB_USER=fiado_user
DB_PASSWORD=troque_esta_senha

# Pasta onde os backups serão salvos por padrão (pode ser alterada na tela de Backup)
BACKUP_DIR=./app/backups

# Pasta onde os logs de erro serão salvos
LOG_DIR=./app/logs
